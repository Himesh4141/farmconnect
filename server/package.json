{
  "name": "farmconnect-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env src/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/cli.js seed",
    "db:list": "node --env-file-if-exists=.env src/cli.js list",
    "db:stock": "node --env-file-if-exists=.env src/cli.js stock",
    "db:price": "node --env-file-if-exists=.env src/cli.js price",
    "db:backup": "node --env-file-if-exists=.env src/cli.js backup",
    "config:check": "node --env-file-if-exists=.env src/check-config.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "google-auth-library": "10.9.1",
    "libsql": "0.5.29"
  }
}
