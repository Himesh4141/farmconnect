# Local development. Copy to .env; never commit real secrets.
PORT=4000
HOST=127.0.0.1
COURIER_MODE=demo
CHECKOUT_ENABLED=true
DATABASE_PATH=data/farmconnect.db
# Optional online payment sandbox. All three must be configured together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Business Delhivery tracking token, kept only on the server.
DELHIVERY_TOKEN=
# Production additionally requires NODE_ENV=production and HTTPS APP_ORIGIN.

# Google OAuth web application. Keep the secret on the server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional automatic address suggestions. Keep this key on the server, never in VITE_* variables.
GEOAPIFY_API_KEY=
